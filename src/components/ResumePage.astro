---
import type { ResumeI18n, NavLabels } from "../i18n/types";
import BaseHead from "./BaseHead.astro";
import Nav from "./Nav.astro";
import WorkExperienceItem from "./WorkExperienceItem.astro";
import EducationItem from "./EducationItem.astro";
import CourseItem from "./CourseItem.astro";
import ProjectItem from "./ProjectItem.astro";
import LanguageItem from "./LanguageItem.astro";
import SkillsSection from "./SkillsSection.astro";
import ResumeJsonLd from "./ResumeJsonLd.astro";
import { SITE_TITLE, SITE_DESCRIPTION, NAME, JOB_TITLE } from "../consts";

interface Props {
  lang: "en" | "it" | "fr";
  i18n: ResumeI18n;
  navLabels: NavLabels;
}

const { lang, i18n, navLabels } = Astro.props;
const t = i18n.labels;

const jobTitle = JOB_TITLE;
const email = "nasir.taov@gmail.com";
const linkedinUrl = "https://www.linkedin.com/in/nasir-taov";
const githubUrl = "https://github.com/t1enne";


---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <BaseHead title={`${SITE_TITLE} - Resume`} description={SITE_DESCRIPTION} />
    <ResumeJsonLd
      name={NAME}
      jobTitle={jobTitle}
      email={email}
      linkedin={linkedinUrl}
      skills={i18n.allSkills}
      languages={i18n.languages}
    />
  </head>
  <body class="print:bg-white text-ink">
    <Nav lang={lang} nav={navLabels} active="resume" name={NAME} title={jobTitle} />
    <main
      class="resume p-6 max-w-3xl mx-auto my-4 text-base print:bg-white"
      itemscope
      itemtype="https://schema.org/Person"
    >
      <meta itemprop="jobTitle" content={jobTitle} />
      <meta itemprop="email" content={email} />

      <!-- Header -->
      <div class="flex items-center justify-between">
        <div class="pr-4 print:w-full print:pr-0">

          <div class="resume-header hidden print:flex">
            <div class="shrink-0">
              <h1 class="resume-name">{NAME}</h1>
              <p class="resume-role">{jobTitle}</p>
            </div>
            <table class="resume-contact ml-auto">
              <tbody>
                <tr>
                  <th scope="row">{t.contactLocation}</th>
                  <td>{t.location}</td>
                </tr>
                <tr>
                  <th scope="row">{t.contactEmail}</th>
                  <td>{email}</td>
                </tr>
                <tr>
                  <th scope="row">{t.contactLinkedin}</th>
                  <td>{linkedinUrl}</td>
                </tr>
                <tr>
                  <th scope="row">{t.contactGithub}</th>
                  <td>{githubUrl}</td>
                </tr>
                <tr>
                  <th scope="row">{t.citizenshipLabel}</th>
                  <td>{t.citizenship}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <h1 class="sr-only print:hidden">{NAME}</h1>
      </div>

      <!-- Summary -->

      <header class="mb-10">
        <p class="resume-summary text-muted font-mono text-sm leading-relaxed max-w-2xl">
          {t.aboutContent}
        </p>
      </header>

      <!-- Work Experience -->
      <section aria-labelledby="work-heading" class="mb-12">
        <h2 id="work-heading" class="sec-title font-bold text-2xl mb-6">{t.workTitle}</h2>
        <ul class="w-full">
          {i18n.workExperience.map((exp) => (
            <WorkExperienceItem
              title={exp.title}
              company={exp.company}
              location={exp.location}
              dates={exp.dates}
              description={exp.description}
              tags={exp.tags}
            />
          ))}
        </ul>
      </section>

      <!-- Projects (only visible when printing / exporting PDF) -->
      <section aria-labelledby="projects-heading" class="hidden print:block mb-12">
        <h2 id="projects-heading" class="sec-title font-bold text-2xl mb-6">{t.projectsTitle}</h2>
        <ul class="w-full space-y-2 print:space-y-0">
          {i18n.projects.map((proj) => (
            <ProjectItem
              title={proj.title}
              period={proj.period}
              technologies={proj.technologies}
              description={proj.description}
              url={proj.url}
              closedSource={proj.closedSource}
            />
          ))}
        </ul>
      </section>

      <!-- Skills -->
      <section aria-labelledby="skills-heading" class="mb-12">
        <SkillsSection categories={i18n.skills} title={t.skillsTitle} />
      </section>

      <!-- Education -->
      <section aria-labelledby="education-heading" class="mb-12">
        <h2 id="education-heading" class="sec-title font-bold text-2xl mb-6">{t.educationTitle}</h2>
        <ul class="w-full">
          {i18n.education.map((edu) => (
            <EducationItem
              title={edu.title}
              degree={edu.degree}
              location={edu.location}
              dates={edu.dates}
              score={edu.score}
              summary={edu.summary}
            />
          ))}
        </ul>
      </section>

      <!-- Courses -->
      <section aria-labelledby="courses-heading" class="mb-12">
        <h2 id="courses-heading" class="sec-title font-bold text-2xl mb-6">{t.coursesTitle}</h2>
        <ul class="w-full divide-y divide-line print:divide-y-0 cols-2">
          {i18n.courses.map((course) => (
            <CourseItem title={course.title} provider={course.provider} dates={course.dates} summary={course.summary} />
          ))}
        </ul>
      </section>

      <!-- Languages -->
      <section aria-labelledby="languages-heading" class="mb-12">
        <h2 id="languages-heading" class="sec-title font-bold text-2xl mb-6">{t.langsTitle}</h2>
        <ul class="w-full divide-y divide-line print:flex print:flex-wrap print:gap-x-5 print:gap-y-[2pt] print:divide-y-0" itemprop="knowsLanguage">
          {i18n.languages.map((langEntry) => (
            <LanguageItem name={langEntry.name} level={langEntry.level} />
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
