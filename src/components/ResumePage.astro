---
import type { ResumeI18n, NavLabels } from "../i18n/types";
import BaseHead from "./BaseHead.astro";
import Nav from "./Nav.astro";
import WorkExperienceItem from "./WorkExperienceItem.astro";
import EducationItem from "./EducationItem.astro";
import CourseItem from "./CourseItem.astro";
import ProjectItem from "./ProjectItem.astro";
import LanguageItem from "./LanguageItem.astro";
import SkillsSection from "./SkillsSection.astro";
import ResumeJsonLd from "./ResumeJsonLd.astro";
import { SITE_TITLE, SITE_DESCRIPTION, NAME, JOB_TITLE } from "../consts";

interface Props {
  lang: "en" | "it" | "fr";
  i18n: ResumeI18n;
  navLabels: NavLabels;
}

const { lang, i18n, navLabels } = Astro.props;
const t = i18n.labels;

const jobTitle = JOB_TITLE;
const email = "nasir.taov@gmail.com";
const phone = "+39 328 1934728";
const linkedinUrl = "https://www.linkedin.com/in/nasir-taov";


---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <BaseHead title={`${SITE_TITLE} - Resume`} description={SITE_DESCRIPTION} />
    <ResumeJsonLd
      name={NAME}
      jobTitle={jobTitle}
      email={email}
      phone={phone}
      linkedin={linkedinUrl}
      skills={i18n.allSkills}
      languages={i18n.languages}
    />
  </head>
  <body class="print:bg-white text-ink">
    <Nav lang={lang} nav={navLabels} active="resume" name={NAME} title={jobTitle} />
    <main
      class="p-6 max-w-3xl mx-auto my-4 text-base print:bg-white print:p-8 print:my-0"
      itemscope
      itemtype="https://schema.org/Person"
    >
      <meta itemprop="jobTitle" content={jobTitle} />
      <meta itemprop="email" content={email} />
      <meta itemprop="telephone" content={phone} />

      <!-- Header -->
      <div class="flex items-center justify-between">
        <div class="pr-4 print:w-full print:pr-0">

          <div class="hidden print:flex print:items-start print:justify-between print:gap-8 print:pb-3 print:mb-3 print:border-b-2 print:border-line">
            <div class="shrink-0">
              <h1 class="font-bold text-2xl text-black">{NAME}</h1>
              <p class="text-sm text-ink mt-1 font-medium">{jobTitle}</p>
            </div>
            <table class="ml-auto border-collapse text-xs">
              <tbody>
                <tr>
                  <td class="font-medium pr-3 text-left align-top whitespace-nowrap">{t.contactLocation}</td>
                  <td class="text-muted text-left whitespace-nowrap">{t.location}</td>
                  <td class="font-medium px-3 text-left align-top whitespace-nowrap">{t.contactEmail}</td>
                  <td class="text-muted text-left whitespace-nowrap">{email}</td>
                </tr>
                <tr>
                  <td class="font-medium pr-3 text-left align-top whitespace-nowrap pt-0.5">{t.contactPhone}</td>
                  <td class="text-muted text-left whitespace-nowrap pt-0.5">{phone}</td>
                  <td class="font-medium px-3 text-left align-top whitespace-nowrap pt-0.5">{t.contactGithub}</td>
                  <td class="text-muted text-left whitespace-nowrap pt-0.5">github.com/t1enne</td>
                </tr>
                <tr>
                  <td class="font-medium pr-3 text-left align-top whitespace-nowrap pt-0.5">{t.contactLinkedin}</td>
                  <td class="text-muted text-left whitespace-nowrap pt-0.5">linkedin.com/in/nasir-taov</td>
                  <td class="font-medium px-3 text-left align-top whitespace-nowrap pt-0.5">{t.citizenshipLabel}</td>
                  <td class="text-muted text-left whitespace-nowrap pt-0.5">{t.citizenship}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <h1 class="sr-only print:hidden">{NAME}</h1>
      </div>

      <!-- Summary -->

      <header class="mb-10">
        <p class="text-muted font-mono text-sm leading-relaxed max-w-2xl">
          {t.aboutContent}
        </p>
      </header>

      <!-- Work Experience -->
      <section aria-labelledby="work-heading" class="mb-12">
        <h2 id="work-heading" class="font-bold text-2xl print:text-lg mb-6">{t.workTitle}</h2>
        <ul class="w-full">
          {i18n.workExperience.map((exp) => (
            <WorkExperienceItem
              title={exp.title}
              company={exp.company}
              location={exp.location}
              dates={exp.dates}
              description={exp.description}
              tags={exp.tags}
            />
          ))}
        </ul>
      </section>

      <!-- Projects (only visible when printing / exporting PDF) -->
      <section aria-labelledby="projects-heading" class="hidden print:block mb-12">
        <h2 id="projects-heading" class="font-bold text-2xl print:text-lg mb-6">{t.projectsTitle}</h2>
        <ul class="w-full space-y-2">
          {i18n.projects.map((proj) => (
            <ProjectItem
              title={proj.title}
              period={proj.period}
              technologies={proj.technologies}
              description={proj.description}
              url={proj.url}
              closedSource={proj.closedSource}
            />
          ))}
        </ul>
      </section>

      <!-- Skills -->
      <section aria-labelledby="skills-heading" class="mb-12">
        <SkillsSection categories={i18n.skills} title={t.skillsTitle} />
      </section>

      <!-- Education -->
      <section aria-labelledby="education-heading" class="mb-12 print:mb-2">
        <h2 id="education-heading" class="font-bold text-2xl mb-6 print:text-lg">{t.educationTitle}</h2>
        <ul class="w-full">
          {i18n.education.map((edu) => (
            <EducationItem
              title={edu.title}
              location={edu.location}
              dates={edu.dates}
              score={edu.score}
            />
          ))}
        </ul>
      </section>

      <!-- Courses -->
      <section aria-labelledby="courses-heading" class="mb-12">
        <h2 id="courses-heading" class="font-bold text-2xl print:text-lg mb-6">{t.coursesTitle}</h2>
        <ul class="w-full space-y-2">
          {i18n.courses.map((course) => (
            <CourseItem title={course.title} provider={course.provider} dates={course.dates} summary={course.summary} />
          ))}
        </ul>
      </section>

      <!-- Languages -->
      <section aria-labelledby="languages-heading" class="mb-12">
        <h2 id="languages-heading" class="font-bold text-2xl print:text-lg mb-6">{t.langsTitle}</h2>
        <ul class="w-full divide-y divide-line" itemprop="knowsLanguage">
          {i18n.languages.map((langEntry) => (
            <LanguageItem name={langEntry.name} level={langEntry.level} />
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
