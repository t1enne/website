---
import type { NavLabels } from "../i18n/types";
import ThemeToggle from "./ThemeToggle.astro";
import LangToggle from "./LangToggle.astro";

interface Props {
  lang: "en" | "it" | "fr";
  nav: NavLabels;
  active?: "resume" | "services" | "portfolio";
  name: string;
  title: string;
}

const { lang, nav, active = "resume", name, title } = Astro.props;

const links = [
  { key: "resume", label: nav.resume, href: `/${lang}/` },
  { key: "services", label: nav.services, href: `/${lang}/services/` },
  { key: "portfolio", label: nav.portfolio, href: `/${lang}/portfolio/` },
] as const;

// Language switcher keeps the user on the same page in another locale.
const pathSegment = active === "resume" ? "" : `/${active}`;
const langLinks = [
  { code: "en", href: `/en${pathSegment}/`, label: "English" },
  { code: "it", href: `/it${pathSegment}/`, label: "Italiano" },
  { code: "fr", href: `/fr${pathSegment}/`, label: "Français" },
];
---

<nav
  class="print:hidden max-w-3xl mx-auto mt-8 px-6 flex flex-col gap-5"
  aria-label="Main navigation"
>

  <div class="w-full flex items-center justify-between gap-4">
    <div class="flex flex-col">
      <span class="font-bold text-lg leading-tight">{name}</span>
      <span class="text-sm text-muted font-mono">{title}</span>
    </div>

    <div class="flex items-center gap-2">
      <img
        src="/self-ascii.png"
        class="nav-avatar h-14 w-14 rounded-full object-cover"
        alt=""
      />
      <div class="flex items-center gap-2">
        <ThemeToggle />
        <LangToggle lang={lang} links={langLinks} />
      </div>
    </div>
  </div>

  <div class="w-full flex justify-between">
    <ul class="flex flex-wrap items-center gap-1 text-sm font-mono">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class={`px-2 py-1 rounded-md transition border ${
              active === link.key
                ? "bg-soft border-line text-primary"
                : "border-transparent text-muted hover:text-ink hover:bg-soft"
            }`}
            aria-current={active === link.key ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
