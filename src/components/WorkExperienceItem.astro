---
import Tag from './Tag.astro';

interface Props {
  title: string;
  company: string;
  location: string;
  dates: string;
  description: string;
  tags?: string[];
}

const { title, company, location, dates, description, tags = [] } = Astro.props;

// Split description into bullet points
const bullets = description.trim().split('\n').filter(line => line.trim());
---

<li class="work-entry mb-6 print:mb-[9pt]" itemscope itemtype="https://schema.org/OrganizationRole">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-0.5">
    <h3 class="entry-title font-bold text-lg" itemprop="roleName">{title}</h3>
    <time class="entry-meta text-muted font-mono text-xs" datetime={dates}>{dates}</time>
  </div>
  <h5 class="entry-sub text-sm text-muted mb-1">
    <span itemprop="name">{company}</span><span class="print:hidden"> - {location}</span><span class="hidden print:inline print:text-muted"> &middot; {location}</span>
  </h5>
  <!-- Tag chips (screen) -->
  <div class="print:hidden flex flex-wrap gap-1 my-2.5">
    {tags.map(tag => <Tag text={tag} />)}
  </div>
  <!-- Tag list (print) -->
  <p class="entry-tags hidden print:block">
    {tags.join('  ·  ')}
  </p>
  <!-- Bullets -->
  <ul class="bullets list-disc list-outside ml-4 space-y-2 print:ml-0 print:space-y-0">
    {bullets.map(bullet => (
      <li class="font-mono text-muted text-xs leading-relaxed">
        {bullet.replace(/^[-•]\s*/, '').trim()}
      </li>
    ))}
  </ul>
</li>
