---
import Tag from './Tag.astro';

import { Github } from "lucide-astro";

interface Props {
  title: string;
  period: string;
  description: string;
  technologies: string[];
  url?: string;
  closedSource?: boolean;
}

const { title, period, description, technologies, url, closedSource } = Astro.props;
---

<li class="keep-together mb-3 print:mb-[7pt]">
  <div class="flex justify-between items-baseline text-sm print:text-[9pt] gap-1">
    <div class="font-semibold flex items-baseline gap-1.5">
      <span class="print:font-bold">{title}</span>
      {url ? (
        <a href={url} target="_blank" rel="noopener" class="print:hidden text-primary/60 hover:text-primary transition">
          <Github size={14} />
        </a>
				<a href={url} target="_blank" rel="noopener" class="hidden print:inline entry-meta print:pl-1">{url}</a>
      ) : closedSource ? (
        <span class="text-xs font-normal text-muted print:hidden">(closed source)</span>
      ) : null}
    </div>
    <div class="font-mono text-xs text-muted entry-meta shrink-0">{period}</div>
  </div>
	<!-- Tag chips (screen) -->
	<div class="print:hidden flex flex-wrap gap-1 my-2">
		{technologies.map(tag => <Tag text={tag} />)}
	</div>
	<!-- Tag list (print) -->
  <p class="entry-tags hidden print:block">
    {technologies.join('  ·  ')}
  </p>
  <p class="entry-desc font-mono text-muted text-xs mt-0.5 print:mt-0">{description}</p>
</li>
